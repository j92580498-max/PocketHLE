<?xml version="1.0" encoding="utf-8"?>
<!-- Stadium/pill version of bg_gamepad_button for wider labels (e.g. "TURBO"). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#3D000000" />
            <corners android:radius="22dp" />
            <stroke
                android:width="1dp"
                android:color="#40FFFFFF" />
        </shape>
    </item>
    <!--
        Without a mask the ripple is clipped to the drawable's *bounds*,
        not to the shape below it, so pressing a D-pad arrow flashed a
        translucent square over the game picture. The mask makes the
        touch feedback the same shape as the button.
    -->
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</ripple>
