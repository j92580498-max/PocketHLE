<?xml version="1.0" encoding="utf-8"?>
<!--
    Circular translucent button used by the virtual gamepad
    (D-pad, A/B/C, soft keys). Ripple gives real touch feedback;
    the base oval keeps the button visible over any game content
    without fully hiding it.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <shape android:shape="oval">
            <solid android:color="#3D000000" />
            <stroke
                android:width="1dp"
                android:color="#40FFFFFF" />
        </shape>
    </item>
</ripple>
