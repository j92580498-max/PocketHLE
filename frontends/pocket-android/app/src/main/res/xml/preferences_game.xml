<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ListPreference
        android:key="cpu_backend"
        android:title="@string/pref_cpu_backend_title"
        android:entries="@array/cpu_backend_entries"
        android:entryValues="@array/cpu_backend_values"
        android:defaultValue="stub" />

    <EditTextPreference
        android:key="max_slices"
        android:title="@string/pref_max_slices_title"
        android:inputType="number"
        android:defaultValue="50000000" />

    <EditTextPreference
        android:key="instructions_per_slice"
        android:title="@string/pref_instr_per_slice_title"
        android:inputType="number"
        android:defaultValue="1000000" />

    <ListPreference
        android:key="screen"
        android:title="@string/pref_screen_title"
        android:entries="@array/screen_entries"
        android:entryValues="@array/screen_values"
        android:defaultValue="portrait" />

    <!--
        Presentation-only quarter turn. A landscape-designed game such
        as JumpyBall renders correctly only while it believes it sits on
        a 240x320 portrait panel, so forcing `screen` to 320x240 breaks
        it; leaving the guest portrait and rotating the picture 90°
        gives the intended landscape view. Mirrors the desktop
        launcher's "Rotate display" setting.
    -->
    <ListPreference
        android:key="rotation"
        android:title="@string/pref_rotation_title"
        android:summary="@string/pref_rotation_summary"
        android:entries="@array/rotation_entries"
        android:entryValues="@array/rotation_values"
        android:defaultValue="none" />

    <SwitchPreferenceCompat
        android:key="halt_on_unimplemented"
        android:title="@string/pref_halt_unimpl_title"
        android:summary="@string/pref_halt_unimpl_summary"
        android:defaultValue="false" />
</PreferenceScreen>
