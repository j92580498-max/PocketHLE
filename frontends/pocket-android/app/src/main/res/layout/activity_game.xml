<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout for the in-game screen.

    The root is a FrameLayout so the virtual gamepad *overlays* the
    framebuffer instead of being a sibling that competes with it for
    height. `GameActivity` is declared with
    `configChanges="orientation|keyboardHidden|screenSize"`, so this file is inflated
    exactly once and has to work in both orientations: the old vertical
    LinearLayout gave the 156dp-tall D-pad and the status panel a fixed
    share of a landscape window barely 360dp high, which squeezed the
    surface to a sliver and pushed the buttons over the toolbar.

    In portrait `GameActivity.updateControlsLayout` pads the game area
    by the height of the control strip, so the picture still sits above
    the buttons the way it always has; in landscape the padding is
    dropped and the semi-transparent buttons float over the picture
    (see the `controls_opacity` preference). The button IDs referenced
    here are wired up in `GameActivity.wireVirtualGamepad`.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <LinearLayout
        android:id="@+id/content_column"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light">

            <ImageButton
                android:id="@+id/btn_fullscreen"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:layout_gravity="end|center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/toggle_fullscreen"
                android:padding="12dp"
                android:src="@drawable/ic_fullscreen"
                android:tint="#FFFFFFFF" />
        </androidx.appcompat.widget.Toolbar>

        <FrameLayout
            android:id="@+id/game_area"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@android:color/black">

            <android.opengl.GLSurfaceView
                android:id="@+id/surface"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/fps_overlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="8dp"
                android:background="#B0000000"
                android:fontFamily="monospace"
                android:padding="6dp"
                android:text="FPS 0"
                android:textColor="#00FF00"
                android:textSize="14sp"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />
            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="#B0000000"
                android:fontFamily="monospace"
                android:maxLines="6"
                android:padding="8dp"
                android:scrollbars="vertical"
                android:textColor="#FFDDDDDD"
                android:textSize="12sp" />
        </FrameLayout>
    </LinearLayout>

    <!--
        Virtual gamepad. Layout mirrors the j2me-loader phone-style
        skin: D-pad on the left half, action + soft buttons on the
        right half. The buttons are plain text Buttons styled with
        a circular background to keep the APK small (no PNG assets
        required).
    -->
    <LinearLayout
        android:id="@+id/game_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:padding="8dp">

        <!--
            D-pad cluster, sized to its contents rather than to a share
            of the window: three 52dp buttons plus 4dp of padding on
            each side is 164dp wide and 156dp tall. `wrap_content` in
            either axis sizes to the largest single child (52dp) and
            collapses up/down onto left/right, hiding the up arrow, so
            both figures are pinned.

            Weighted halves were worse than they look on a phone: in
            landscape the cluster stretched to 1200px and threw the
            right arrow into the middle of the picture (and the action
            cluster's A/B/C row with it). A fixed cluster at each end,
            with the `Space` below taking up the slack, keeps the arrows
            hard against the left edge and the face buttons against the
            right in both orientations.
        -->
        <FrameLayout
            android:layout_width="164dp"
            android:layout_height="wrap_content"
            android:minHeight="156dp"
            android:padding="4dp">

            <Button
                android:id="@+id/btn_up"
                style="@null"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center_horizontal|top"
                android:background="@drawable/bg_gamepad_button"
                android:contentDescription="@string/dpad_up"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:stateListAnimator="@null"
                android:text="@string/dpad_up_glyph"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btn_down"
                style="@null"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center_horizontal|bottom"
                android:background="@drawable/bg_gamepad_button"
                android:contentDescription="@string/dpad_down"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:stateListAnimator="@null"
                android:text="@string/dpad_down_glyph"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btn_left"
                style="@null"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/bg_gamepad_button"
                android:contentDescription="@string/dpad_left"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:stateListAnimator="@null"
                android:text="@string/dpad_left_glyph"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btn_right"
                style="@null"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="end|center_vertical"
                android:background="@drawable/bg_gamepad_button"
                android:contentDescription="@string/dpad_right"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:stateListAnimator="@null"
                android:text="@string/dpad_right_glyph"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp" />
        </FrameLayout>

        <!--
            All the free width lives here, between the two clusters, so
            the middle of the screen — where the picture is — stays
            clear of buttons.
        -->
        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Action / soft-key cluster. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_soft1"
                    style="@null"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_gamepad_button"
                    android:includeFontPadding="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:stateListAnimator="@null"
                    android:text="@string/soft1_label"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_soft2"
                    style="@null"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_gamepad_button"
                    android:includeFontPadding="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:stateListAnimator="@null"
                    android:text="@string/soft2_label"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_action"
                style="@null"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_gamepad_button_action"
                android:contentDescription="@string/action_button"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:stateListAnimator="@null"
                android:text="@string/action_button_glyph"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp" />
            <Button
                android:id="@+id/btn_turbo"
                style="@null"
                android:layout_width="88dp"
                android:layout_height="36dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_gamepad_button_pill"
                android:contentDescription="@string/turbo_button"
                android:includeFontPadding="false"
                android:letterSpacing="0.05"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:stateListAnimator="@null"
                android:text="@string/turbo_button_label"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_a"
                    style="@null"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_gamepad_button"
                    android:includeFontPadding="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:stateListAnimator="@null"
                    android:text="@string/key_a_label"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btn_b"
                    style="@null"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginHorizontal="4dp"
                    android:background="@drawable/bg_gamepad_button"
                    android:includeFontPadding="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:stateListAnimator="@null"
                    android:text="@string/key_b_label"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btn_c"
                    style="@null"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_gamepad_button"
                    android:includeFontPadding="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:stateListAnimator="@null"
                    android:text="@string/key_c_label"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
